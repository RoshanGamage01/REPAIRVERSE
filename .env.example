# ── Core ────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/repairverse
# Optional: shared rate limits across instances (falls back to in-memory)
REDIS_URL=redis://localhost:6379
# REQUIRED in production: long random string (signs file URLs)
APP_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=http://localhost:5173
COOKIE_SECURE=false

# ── Seeding ─────────────────────────────────────────────
ADMIN_EMAIL=admin@repairverse.dev
ADMIN_PASSWORD=admin-password-123
# Demonstration data (fictional products). Defaults to true outside production.
SEED_DEMO=true

# ── Object storage ──────────────────────────────────────
STORAGE_DRIVER=local            # local | s3
STORAGE_LOCAL_DIR=./storage
# S3_BUCKET=repairverse-files
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000   # MinIO or another S3-compatible store
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=50

# ── AI providers (optional — the platform works without them) ──
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MONTHLY_BUDGET_USD=200

# ── Operations ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=300
RUN_WORKER_IN_PROCESS=true      # set false when running the separate worker process
LOG_LEVEL=info
# SERVE_WEB_DIST=../web/dist    # single-origin deployment: the API serves the built web app
